# Production: consume the locally verified, immutable frontend release.
FROM nginx:stable-alpine

ARG FRONTEND_VERSION=frontend-2026.10.26.3
ARG FRONTEND_SHA256=5c1c58134d8c62d4b20ca367dc4dc6a6c7013ac3f99bc6aeda612860334eb344
RUN wget -T 60 -O /tmp/frontend.tar.gz "https://github.com/pkhosn/flux-panel/releases/download/${FRONTEND_VERSION}/flux-frontend.tar.gz" \
    && echo "${FRONTEND_SHA256}  /tmp/frontend.tar.gz" | sha256sum -c - \
    && rm -rf /usr/share/nginx/html/* \
    && tar -xzf /tmp/frontend.tar.gz -C /usr/share/nginx/html \
    && test -s /usr/share/nginx/html/index.html \
    && rm /tmp/frontend.tar.gz
COPY nginx.conf /etc/nginx/nginx.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
